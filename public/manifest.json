{
  "name": "CustomNewTab",
  "description": "Custom new tab page by @devboiagru for productivity.",
  "version": "1.1.1",
  "incognito": "split",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128":"icons/icon128.png"
  },
  "manifest_version": 3,
  "permissions": [
    "favicon"
  ]
}